# Copy to .env.local. Keep actual credentials out of Git and chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Required for public production generation. Use your shared Redis REST service.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional global daily request ceiling (includes revisions).
DAILY_REQUEST_LIMIT=100
